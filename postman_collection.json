    {
      "name": "Appointments",
      "description": "Book / reschedule / cancel (PATIENT-only) + participant-scoped reads.",
      "item": [
        {
          "name": "Book appointment (captures appointmentId + sessionId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "Expect 201 and a nested consultationSession (SCHEDULED). 409 if the slot is already consumed (double-book).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilityId\": \"{{slotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set(\"appointmentId\", json.id);",
                  "  if (json.patientProfileId) { pm.environment.set(\"patientProfileId\", json.patientProfileId); }",
                  "  if (json.consultationSession && json.consultationSession.id) {",
                  "    pm.environment.set(\"sessionId\", json.consultationSession.id);",
                  "  }",
                  "}",
                  "pm.test(\"booking succeeded (or 409 if slot already consumed)\", () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "NEGATIVE - double-book the same slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "description": "Expect 409 Conflict -- the slot from the previous booking is already consumed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilityId\": \"{{slotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"duplicate booking is rejected with 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}",
