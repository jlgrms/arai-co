{
  "info": {
    "name": "Telehealth App - Layers 1-4 (sub-items 1-7)",
    "description": "Full API surface built through Layer 4 sub-item 7. Excludes notifications (sub-item 8) and admin (sub-item 9). Run folder-by-folder top-to-bottom: Auth first to populate tokens, then Doctors (availability -> slotId), then Appointments (booking -> appointmentId + sessionId), then Consultations. Deliberately-failing requests document the negative paths.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Registration and login. Login requests auto-populate tokens.",
      "item": [
        {
          "name": "Login - patient (jordan.lee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Expect 200; sets {{patientToken}}. 401 on bad password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jordan.lee@example.com\",\n  \"password\": \"PatientPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.environment.set(\"patientToken\", json.accessToken); }",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
