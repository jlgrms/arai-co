# ------------------------------------------------------------------
# Telehealth App — environment template
# Copy to `.env` and adjust as needed: `cp .env.example .env`
# `.env` is gitignored; this template is committed.
# ------------------------------------------------------------------

# Postgres is reached via the Compose service name, NOT localhost,
# because the backend connects to it over the internal Docker network.
DATABASE_URL="postgresql://telehealth:telehealth@postgres:5432/telehealth?schema=public"

# Credentials used by the postgres container itself.
POSTGRES_USER=telehealth
POSTGRES_PASSWORD=telehealth
POSTGRES_DB=telehealth
POSTGRES_PORT=5432

# Backend runtime
BACKEND_PORT=3000
NODE_ENV=development

# Frontend runtime
FRONTEND_PORT=5173
# Base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:3000

# JWT signing secret (app-managed auth — Layer 3). Placeholder for now.
JWT_SECRET=change-me-in-a-real-deployment
JWT_EXPIRES_IN=1d
